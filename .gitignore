# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
*.egg-info/
build/
dist/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.uv-cache/
.matplotlib-cache/

# Local research datasets are required for reproduction but are not source code
data/dnrti/

# Model weights are downloaded locally BEFORE the Docker build — never commit them
model_cache/

# Claude Code local agent state
.claude/

# Streamlit secrets
.streamlit/secrets.toml

# OS / editor
.DS_Store
.vscode/
.idea/

# reports/fork1: commit the consolidated reports (README + 0X_*.md) and figures only.
# Raw machine-readable outputs are regenerable via `make reproduce`.
reports/fork1/*.jsonl
reports/fork1/run_metadata.json
reports/fork1/*.md
!reports/fork1/README.md
!reports/fork1/0[0-9]_*.md
