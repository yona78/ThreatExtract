[flake8]
# flake8 does not read pyproject.toml natively, so its config lives here.
max-line-length = 100
# E203 and W503 conflict with black's formatting; ignore them.
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    model_cache,
    docs
